## Whole script: one batch, all iteration and function calls in RiX.
## Inputs: bases (sequence of nonnegative Integers), exponent >= 0, modulus > 0.
Power(base,exponent,modulus) -> {@ <base,exponent,modulus> b=base%modulus,e=exponent,r=1%modulus;
  e>0;
  r := e%2==1 ?: r*b%modulus ?_ r,
  b := b*b%modulus,
  e //= 2;
  ; r };

Run(bases,exponent,modulus) -> bases.Map((base)->Power(base,@exponent,@modulus));
Run(bases,exponent,modulus);
